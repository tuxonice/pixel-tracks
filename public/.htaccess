RewriteEngine On
RewriteBase /

# Allow direct access to existing files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Do not route static asset requests through PHP.
# If the file is missing, Apache will return a 404 directly instead of
# hitting the application and accidentally rotating the session CSRF token.
RewriteCond %{REQUEST_URI} ^/(css|js|plugins|img|fonts|assets)(/|$) [NC,OR]
RewriteCond %{REQUEST_URI} ^/favicon\.ico$ [NC]
RewriteRule ^ - [L]

# Redirect everything else to index.php
RewriteRule ^ index.php [QSA,L]
