# .env.test is loaded automatically by Symfony (Dotenv) when APP_ENV=test, layered on top of
# .env — it only needs to override what differs for the test suite.

# Keep the test suite off the dev database entirely.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/database/database_test.sqlite"

# Don't actually send mail (or hit Mailpit) while running tests.
MAILER_DSN=null://null

# Keep uploaded-file tests off real uploaded data too.
UPLOAD_DATA_SUBDIR=var/data_test
